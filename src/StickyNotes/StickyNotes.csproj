<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>StickyNotes</AssemblyName>
    <RootNamespace>StickyNotes</RootNamespace>
    <Product>Sticky Notes</Product>
    <!-- WPF owns the process, so per-monitor DPI is declared in app.manifest. -->
    <NoWarn>$(NoWarn);WFO0003</NoWarn>
    <!-- No StickyNotes.exe launcher: Defender flags the unsigned apphost. The app runs as
         "dotnet StickyNotes.dll" instead (see App.LaunchCommand). -->
    <UseAppHost>false</UseAppHost>
  </PropertyGroup>

</Project>
